# CommunityOS Mobile — example environment. Copy to .env in each app (apps/resident, apps/guard).
# Nothing is hardcoded in source: the API base URL and OneSignal app id come from here.
# Expo exposes EXPO_PUBLIC_* vars to the JS bundle at build time.

# Backend REST API base. Must be HTTPS in production (Req: HTTPS-only).
EXPO_PUBLIC_API_BASE_URL=https://api.communityos.example.com

# OneSignal application id (public id, not the REST API key — the key stays server-side).
EXPO_PUBLIC_ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000

# Backend endpoint that stores a device's OneSignal player/subscription id (Device concept).
# Overridable so it can track the backend route without a code change.
EXPO_PUBLIC_DEVICE_REGISTER_PATH=/api/v1/devices
