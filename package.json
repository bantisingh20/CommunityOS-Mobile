{
  "name": "communityos-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "CommunityOS React Native workspace: Resident/Owner and Security/Guard apps with a shared internal core.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck -w @communityos/shared",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "resident": "npm run start -w @communityos/resident",
    "guard": "npm run start -w @communityos/guard"
  }
}
